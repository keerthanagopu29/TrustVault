# Required server configuration. Copy to .env locally and fill in real values.
MONGODB_URI=mongodb://127.0.0.1:27017/trustvault
SESSION_SECRET=replace-with-a-long-random-secret
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Optional production password-reset delivery webhook.
# The endpoint must send the supplied resetUrl to the account email address.
# It receives JSON: { email, token, expiresInMinutes, resetUrl } and Authorization: Bearer <secret>.
PASSWORD_RESET_WEBHOOK_URL=
PASSWORD_RESET_WEBHOOK_SECRET=

# Optional demo account seeding. Set strong temporary passwords before running the seed script.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=
DEMO_VIEWER_EMAIL=
DEMO_VIEWER_PASSWORD=
